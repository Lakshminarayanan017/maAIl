# Vite convention: this file is committed, `.env.*.local` is not. It holds a
# URL, never a secret — anything in a VITE_ variable is compiled into the
# bundle and is public by construction.
#
# The API is a separate origin in development because it is a separate origin
# in production. Proxying it through Vite would hide every CORS and cookie
# problem until deploy day.
VITE_API_BASE_URL=http://localhost:8000
