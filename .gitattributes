# LF in the repository, always. A shell script checked out with CRLF fails on
# Linux with "bad interpreter", which is a confusing way to learn about line
# endings in CI.
* text=auto eol=lf

*.sh      text eol=lf
*.sql     text eol=lf
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.json    text eol=lf

*.png     binary
*.jpg     binary
*.ico     binary
*.woff    binary
*.woff2   binary

# Generated. Keep it out of review diffs.
package-lock.json  linguist-generated=true -diff
