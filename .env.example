# Maail — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
# Phase 0 needs only the database block. Later phases add their own keys and
# document them here; an unset key fails loudly at startup, never silently.
# ---------------------------------------------------------------------------

MAAIL_ENV=development
MAAIL_LOG_LEVEL=INFO

# Postgres — owner role, used ONLY by migrations and db.sh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maail
POSTGRES_OWNER_USER=maail_owner
POSTGRES_OWNER_PASSWORD=change_me_owner

# Postgres — the application's own role. Non-owner, non-superuser.
# This is what makes FORCE ROW LEVEL SECURITY inescapable (02-lld-data-model.md §8).
POSTGRES_APP_USER=maail_app
POSTGRES_APP_PASSWORD=change_me_app

# Session signing. Rotate by prepending; old keys stay for verification.
SESSION_SECRET=change_me_to_32_bytes_minimum_abcdef

# Frontend origin allowed to send credentialed requests
CORS_ORIGINS=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
SESSION_TTL_DAYS=14

# Credential encryption (gap D8). "<version>:<base64 32-byte key>", comma
# separated; every listed version stays readable so rotation can re-wrap rows
# in the background. Generate one with:
#   python -m app.core.crypto
# This development key is in version control on purpose. Replace it.
DATA_ENCRYPTION_KEYS=1:CyB2UcldXTK02oZyXPSafdcv8sky7eQZ7qu0j7TvH-A=
DATA_ENCRYPTION_KEY_VERSION=1

# Google OAuth. Create an OAuth client at console.cloud.google.com, type
# "Web application", and add GOOGLE_REDIRECT_URI as an authorised redirect URI.
# The only scope v1 requests is gmail.readonly. Sending gets its own
# authorisation later, and is not granted here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# While the OAuth app is in Testing, Google expires a test user's refresh
# token after ~7 days and caps you at 100 test users (gap A3). v1 accepts
# that: reauth_required is a first-class state, not an error.
GOOGLE_OAUTH_TESTING_MODE=true
GOOGLE_TESTING_REFRESH_TTL_DAYS=7
